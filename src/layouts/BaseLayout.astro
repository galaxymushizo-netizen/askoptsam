---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, type Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
  bodyClass?: string;
  mainClass?: string;
}

const { title, description, lang, noindex = false, bodyClass = '', mainClass = '' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).toString();
const htmlLang = languages[lang].htmlLang;
const ogLocale = lang === 'sw' ? 'sw_TZ' : 'en_TZ';
const siteName = 'AskOptsam';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0a5c50" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{Astro.locals.lang === 'sw' ? 'Ruka hadi maudhui makuu' : 'Skip to main content'}</a>
    <Header lang={lang} />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <noscript>
      <div class="container noscript-wrap">
        <div class="notice-banner notice-banner--warn">
          {lang === 'sw'
            ? 'Mazungumzo ya AskOptsam yanahitaji JavaScript. Maktaba ya elimu na mwongozo wa dharura bado unapatikana.'
            : 'The AskOptsam chat needs JavaScript. The education library and urgent guidance still work.'}
        </div>
      </div>
    </noscript>
    <Footer lang={lang} />
  </body>
</html>
