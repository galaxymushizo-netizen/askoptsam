---
import type { ChatMode } from '../lib/ai/service';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  mode: ChatMode;
}

const { lang, mode } = Astro.props;
const label =
  mode === 'live'
    ? t(lang, 'chat.modeLive')
    : mode === 'safety'
      ? t(lang, 'chat.modeSafety')
      : t(lang, 'chat.modeDemo');
const className =
  mode === 'live' ? 'pill pill--live' : mode === 'safety' ? 'pill pill--safety' : 'pill pill--demo';
---

<span class={className}>
  <span class="status-dot" aria-hidden="true"></span>
  {label}
</span>
