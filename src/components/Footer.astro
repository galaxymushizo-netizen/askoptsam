---
import BrandMark from './BrandMark.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label={t(lang, 'nav.home')}>
        <span class="brand-mark"><BrandMark /></span>
        <span class="brand-copy">
          <span class="brand-name">AskOptsam</span>
          <span class="brand-sub">{t(lang, 'brand.association')}</span>
        </span>
      </a>
      <p>{t(lang, 'footer.disclaimer')}</p>
      <div class="footer-emergency">
        <strong>{t(lang, 'footer.emergencyTitle')}:</strong> {t(lang, 'footer.emergency')}
      </div>
    </div>

    <div class="footer-col">
      <h2>{t(lang, 'footer.learn')}</h2>
      <ul>
        <li><a href="/learn">{t(lang, 'learn.title')}</a></li>
        <li><a href="/warning-signs">{t(lang, 'nav.emergency')}</a></li>
        <li><a href="/sources">{t(lang, 'footer.sources')}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>AskOptsam</h2>
      <ul>
        <li><a href="/chat">{t(lang, 'nav.startChat')}</a></li>
        <li><a href="/about">{t(lang, 'footer.about')}</a></li>
        <li><a href="/status">{t(lang, 'footer.status')}</a></li>
      </ul>
    </div>

    <div class="footer-col footer-col--wide">
      <h2>{t(lang, 'footer.privacy')} &amp; {t(lang, 'footer.terms')}</h2>
      <ul>
        <li><a href="/privacy">{t(lang, 'footer.privacy')}</a></li>
        <li><a href="/terms">{t(lang, 'footer.terms')}</a></li>
        <li><a href="/medical-disclaimer">{t(lang, 'footer.medical')}</a></li>
      </ul>
      <p class="footer-contact-note">{t(lang, 'footer.contactPending')}</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {t(lang, 'footer.rights')}</span>
    <span>{t(lang, 'footer.contactPending')}</span>
  </div>
</footer>
