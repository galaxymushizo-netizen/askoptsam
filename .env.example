# ---------------------------------------------------------------------------
# AskOptsam environment template
# Copy to .env and fill in only what you need. Never commit .env.
# Values prefixed PUBLIC_ are safe to expose; everything else stays server-side.
# ---------------------------------------------------------------------------

# Canonical public URL used for metadata and auth redirects.
PUBLIC_SITE_URL=http://localhost:4321

# Contact details are intentionally not configured in this MVP. Do not add
# unverified clinic locations, phone numbers, hours, or email addresses.

# ---------------------------------------------------------------------------
# Supabase (optional for temporary chat; required for accounts + saved history)
# Create a project at https://supabase.com, then run supabase/migrations.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Required for complete account deletion. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider
# AI_PROVIDER: demo | gemini | openai-compatible
# Live providers require AI_PRIVACY_APPROVED=true. Do not set this until you
# have reviewed the provider's current terms for sensitive health data.
# ---------------------------------------------------------------------------
AI_PROVIDER=demo
AI_ENABLED=true
AI_MODEL=
AI_PRIVACY_APPROVED=false
AI_PRIVACY_REVIEWED_AT=
AI_PROVIDER_TERMS_URL=

# Gemini (Google AI Studio key)
GEMINI_API_KEY=

# Any OpenAI-compatible chat-completions endpoint (OpenAI, Azure-compatible
# gateway, self-hosted vLLM, etc.). Confirm the provider's data policy first.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Hard limits enforced by the app (not a substitute for provider-side caps).
AI_MAX_OUTPUT_TOKENS=700
AI_TIMEOUT_MS=45000
AI_DAILY_REQUEST_LIMIT=300
AI_MONTHLY_REQUEST_LIMIT=3000

# ---------------------------------------------------------------------------
# Abuse protection / cost control
# RATE_LIMIT_SALT: random string, at least 32 chars, used to hash IPs in memory.
# TRUST_PROXY=true only when a trusted reverse proxy sets X-Forwarded-For.
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=80
RATE_LIMIT_SALT=
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Image explanation is intentionally unavailable in this MVP. There is no
# upload, storage, or image-provider pipeline, and /api/image refuses every
# request. Do not advertise image analysis until that pipeline is implemented
# and separately reviewed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Policy / consent versioning
# ---------------------------------------------------------------------------
POLICY_VERSION=2026-10-19
